rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validPublicRole(role) {
      return role == 'crew' || role == 'operator';
    }

    function validInitialProfile(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'role', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'role', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && validPublicRole(request.resource.data.role)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    function protectedProfileFieldsAreUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'admin',
        'isAdmin',
        'status',
        'approvalStatus',
        'verificationStatus',
        'verified'
      ]);
    }

    function onlyEditableProfileFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'phone',
        'airline',
        'baseAirport',
        'homeZone',
        'product',
        'productSelectedAt',
        'profileComplete',
        'companyName',
        'vehicleType',
        'plateNumber',
        'coverageZones',
        'capacity',
        'onboardingStage',
        'documentsSubmittedAt',
        'documents',
        'updatedAt'
      ]);
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCrew() { return signedIn() && profile().role == 'crew'; }
    function isOperator() { return signedIn() && profile().role == 'operator' && profile().status == 'approved'; }
    function crewOnTrip(data) { return isCrew() && request.auth.uid in data.crewIds; }
    function operatorOnTrip(data) {
      return isOperator()
        && (data.operatorId == request.auth.uid || data.driverId == request.auth.uid);
    }

    match /users/{userId} {
      allow create: if validInitialProfile(userId);
      allow read: if isOwner(userId);
      allow update: if isOwner(userId)
        && protectedProfileFieldsAreUnchanged()
        && onlyEditableProfileFieldsChanged();
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow read: if crewOnTrip(resource.data) || operatorOnTrip(resource.data);
      allow write: if false;
    }

    match /rosters/{rosterId} {
      allow read: if isCrew() && resource.data.crewId == request.auth.uid;
      // Parser output, confirmation, retries, and deterministic generation go
      // through the authenticated roster backend. This prevents a client from
      // overwriting parser metadata or bypassing idempotent generation.
      allow write: if false;
    }

    match /transportRequirements/{requirementId} {
      allow read: if isCrew()
        && (resource.data.crewId == request.auth.uid
          || request.auth.uid in resource.data.crewIds);
      allow write: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isOperator() && resource.data.operatorId == request.auth.uid;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      function ownsNotification(data) {
        return signedIn() && data.recipientId == request.auth.uid;
      }
      allow read: if ownsNotification(resource.data);
      allow update: if ownsNotification(resource.data)
        && ownsNotification(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read', 'readAt'
        ])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
